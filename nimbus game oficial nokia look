<script>

/* =========================================================
   NIMBUS
   GAME ENGINE
   ========================================================= */


/* ---------------------------------------------------------
   CANVAS
   --------------------------------------------------------- */

const canvas =
    document.getElementById("gameCanvas");

const ctx =
    canvas.getContext("2d");


/* ---------------------------------------------------------
   GAME SETTINGS
   --------------------------------------------------------- */

const GRID_SIZE = 20;

const CANVAS_SIZE = 400;

const CELL_SIZE =
    CANVAS_SIZE / GRID_SIZE;


/* ---------------------------------------------------------
   COLORS
   --------------------------------------------------------- */

const LCD_BACKGROUND = "#9bbc0f";

const LCD_GRID = "rgba(50,70,0,0.09)";

const SNAKE_HEAD = "#173600";

const SNAKE_BODY = "#315400";

const FOOD_COLOR = "#173600";


/* ---------------------------------------------------------
   DOM
   --------------------------------------------------------- */

const scoreElement =
    document.getElementById("score");

const highScoreElement =
    document.getElementById("highScore");

const startOverlay =
    document.getElementById("startOverlay");

const pauseOverlay =
    document.getElementById("pauseOverlay");

const gameOverOverlay =
    document.getElementById("gameOverOverlay");

const finalScore =
    document.getElementById("finalScore");


/* ---------------------------------------------------------
   GAME STATE
   --------------------------------------------------------- */

let snake = [];

let food = {
    x: 0,
    y: 0
};

let direction = {
    x: 1,
    y: 0
};

let queuedDirection = {
    x: 1,
    y: 0
};

let score = 0;

let highScore =
    Number(
        localStorage.getItem(
            "nimbus-high-score"
        )
    ) || 0;

let running = false;

let paused = false;

let lastUpdateTime = 0;

let moveInterval = 140;

let animationFrame = null;


/* ---------------------------------------------------------
   INITIAL SCORE
   --------------------------------------------------------- */

highScoreElement.textContent =
    highScore;


/* =========================================================
   AUDIO
   ========================================================= */

let audioContext = null;


function getAudioContext() {

    if (!audioContext) {

        const AudioContext =
            window.AudioContext ||
            window.webkitAudioContext;

        if (AudioContext) {
            audioContext =
                new AudioContext();
        }
    }

    return audioContext;
}


function sound(frequency, duration) {

    const audio =
        getAudioContext();

    if (!audio) return;

    const oscillator =
        audio.createOscillator();

    const gain =
        audio.createGain();

    oscillator.type = "square";

    oscillator.frequency.value =
        frequency;

    gain.gain.setValueAtTime(
        0.035,
        audio.currentTime
    );

    gain.gain.exponentialRampToValueAtTime(
        0.001,
        audio.currentTime + duration
    );

    oscillator.connect(gain);

    gain.connect(audio.destination);

    oscillator.start();

    oscillator.stop(
        audio.currentTime + duration
    );
}


/* =========================================================
   START / RESET
   ========================================================= */

function startGame() {

    /* Cancel any previous animation */

    if (animationFrame !== null) {

        cancelAnimationFrame(
            animationFrame
        );

        animationFrame = null;
    }


    /* Create initial snake */

    snake = [

        { x: 10, y: 10 },

        { x: 9, y: 10 },

        { x: 8, y: 10 },

        { x: 7, y: 10 }

    ];


    /* Initial direction */

    direction = {
        x: 1,
        y: 0
    };

    queuedDirection = {
        x: 1,
        y: 0
    };


    /* Reset score */

    score = 0;

    scoreElement.textContent = "0";


    /* Reset speed */

    moveInterval = 140;


    /* Generate food */

    food = generateFood();


    /* Game state */

    running = true;

    paused = false;


    /* Hide overlays */

    startOverlay.classList.add("hidden");

    pauseOverlay.classList.add("hidden");

    gameOverOverlay.classList.add("hidden");


    /* Reset timing */

    lastUpdateTime =
        performance.now();


    /* Sound */

    sound(650, 0.08);


    /* Draw immediately */

    draw();


    /* Start engine */

    animationFrame =
        requestAnimationFrame(
            gameLoop
        );
}


/* =========================================================
   GAME LOOP
   ========================================================= */

function gameLoop(timestamp) {

    if (!running) {
        return;
    }


    animationFrame =
        requestAnimationFrame(
            gameLoop
        );


    if (paused) {

        lastUpdateTime =
            timestamp;

        return;
    }


    const elapsed =
        timestamp - lastUpdateTime;


    if (elapsed >= moveInterval) {

        lastUpdateTime =
            timestamp;

        updateGame();
    }


    draw();
}


/* =========================================================
   UPDATE GAME
   ========================================================= */

function updateGame() {

    /*
     Apply the queued direction only
     at the beginning of a movement.
    */

    direction = {
        x: queuedDirection.x,
        y: queuedDirection.y
    };


    const head = {
        x: snake[0].x + direction.x,
        y: snake[0].y + direction.y
    };


    /* -----------------------------------------------------
       WALL COLLISION
       ----------------------------------------------------- */

    if (
        head.x < 0 ||
        head.x >= GRID_SIZE ||
        head.y < 0 ||
        head.y >= GRID_SIZE
    ) {

        endGame();

        return;
    }


    /* -----------------------------------------------------
       SELF COLLISION
       ----------------------------------------------------- */

    /*
     Normally the tail moves away during a
     normal step, so collision checking against
     the whole snake is correct for this game.
    */

    const hitSelf =
        snake.some(
            segment =>
                segment.x === head.x &&
                segment.y === head.y
        );


    if (hitSelf) {

        endGame();

        return;
    }


    /* -----------------------------------------------------
       ADD NEW HEAD
       ----------------------------------------------------- */

    snake.unshift(head);


    /* -----------------------------------------------------
       FOOD
       ----------------------------------------------------- */

    const ateFood =
        head.x === food.x &&
        head.y === food.y;


    if (ateFood) {

        score++;

        scoreElement.textContent =
            score;


        /* Update high score */

        if (score > highScore) {

            highScore = score;

            highScoreElement.textContent =
                highScore;

            localStorage.setItem(
                "nimbus-high-score",
                String(highScore)
            );
        }


        /* New food */

        food = generateFood();


        /* Speed increases gradually */

        moveInterval =
            Math.max(
                55,
                140 - score * 3
            );


        sound(550, 0.07);

    } else {

        /* Remove tail */

        snake.pop();
    }
}


/* =========================================================
   GENERATE FOOD
   ========================================================= */

function generateFood() {

    const availableCells = [];


    /*
     Build a list of all cells that
     are NOT occupied by the snake.
    */

    for (
        let y = 0;
        y < GRID_SIZE;
        y++
    ) {

        for (
            let x = 0;
            x < GRID_SIZE;
            x++
        ) {

            const occupied =
                snake.some(
                    segment =>
                        segment.x === x &&
                        segment.y === y
                );


            if (!occupied) {

                availableCells.push({
                    x: x,
                    y: y
                });
            }
        }
    }


    /* If board is completely full */

    if (availableCells.length === 0) {

        return {
            x: -1,
            y: -1
        };
    }


    const randomIndex =
        Math.floor(
            Math.random() *
            availableCells.length
        );


    return availableCells[randomIndex];
}


/* =========================================================
   DRAW
   ========================================================= */

function draw() {

    /* Background */

    ctx.fillStyle =
        LCD_BACKGROUND;

    ctx.fillRect(
        0,
        0,
        CANVAS_SIZE,
        CANVAS_SIZE
    );


    /* Grid */

    drawGrid();


    /* Food */

    if (
        food.x >= 0 &&
        food.y >= 0
    ) {

        drawFood();
    }


    /* Snake */

    drawSnake();
}


/* =========================================================
   DRAW GRID
   ========================================================= */

function drawGrid() {

    ctx.strokeStyle =
        LCD_GRID;

    ctx.lineWidth = 1;


    for (
        let i = 0;
        i <= GRID_SIZE;
        i++
    ) {

        const position =
            i * CELL_SIZE;


        /* Vertical */

        ctx.beginPath();

        ctx.moveTo(
            position,
            0
        );

        ctx.lineTo(
            position,
            CANVAS_SIZE
        );

        ctx.stroke();


        /* Horizontal */

        ctx.beginPath();

        ctx.moveTo(
            0,
            position
        );

        ctx.lineTo(
            CANVAS_SIZE,
            position
        );

        ctx.stroke();
    }
}


/* =========================================================
   DRAW FOOD
   ========================================================= */

function drawFood() {

    const x =
        food.x * CELL_SIZE;

    const y =
        food.y * CELL_SIZE;


    ctx.fillStyle =
        FOOD_COLOR;


    /*
     Classic pixel-style food.
    */

    ctx.fillRect(
        x + 5,
        y + 5,
        CELL_SIZE - 10,
        CELL_SIZE - 10
    );


    ctx.fillStyle =
        LCD_BACKGROUND;


    ctx.fillRect(
        x + 9,
        y + 9,
        3,
        3
    );
}


/* =========================================================
   DRAW SNAKE
   ========================================================= */

function drawSnake() {

    snake.forEach(
        (segment, index) => {

            const x =
                segment.x * CELL_SIZE;

            const y =
                segment.y * CELL_SIZE;


            if (index === 0) {

                drawSnakeHead(
                    x,
                    y
                );

            } else {

                drawSnakeBody(
                    x,
                    y
                );
            }
        }
    );
}


/* =========================================================
   DRAW HEAD
   ========================================================= */

function drawSnakeHead(x, y) {

    ctx.fillStyle =
        SNAKE_HEAD;


    ctx.fillRect(
        x + 1,
        y + 1,
        CELL_SIZE - 2,
        CELL_SIZE - 2
    );


    /* Eyes */

    ctx.fillStyle =
        LCD_BACKGROUND;


    if (direction.x !== 0) {

        const eyeX =
            direction.x > 0
                ? x + CELL_SIZE - 7
                : x + 4;


        ctx.fillRect(
            eyeX,
            y + 5,
            3,
            3
        );

        ctx.fillRect(
            eyeX,
            y + CELL_SIZE - 8,
            3,
            3
        );

    } else {

        const eyeY =
            direction.y > 0
                ? y + CELL_SIZE - 7
                : y + 4;


        ctx.fillRect(
            x + 5,
            eyeY,
            3,
            3
        );

        ctx.fillRect(
            x + CELL_SIZE - 8,
            eyeY,
            3,
            3
        );
    }
}


/* =========================================================
   DRAW BODY
   ========================================================= */

function drawSnakeBody(x, y) {

    ctx.fillStyle =
        SNAKE_BODY;


    ctx.fillRect(
        x + 2,
        y + 2,
        CELL_SIZE - 4,
        CELL_SIZE - 4
    );
}


/* =========================================================
   END GAME
   ========================================================= */

function endGame() {

    running = false;

    paused = false;


    if (animationFrame !== null) {

        cancelAnimationFrame(
            animationFrame
        );

        animationFrame = null;
    }


    finalScore.textContent =
        "SCORE: " + score;


    gameOverOverlay.classList.remove(
        "hidden"
    );


    sound(130, 0.25);


    draw();
}


/* =========================================================
   PAUSE
   ========================================================= */

function togglePause() {

    if (!running) {
        return;
    }


    paused = !paused;


    if (paused) {

        pauseOverlay.classList.remove(
            "hidden"
        );

    } else {

        pauseOverlay.classList.add(
            "hidden"
        );


        lastUpdateTime =
            performance.now();
    }
}


/* =========================================================
   CHANGE DIRECTION
   ========================================================= */

function changeDirection(x, y) {

    if (!running || paused) {
        return;
    }


    /*
     IMPORTANT:

     Check against queuedDirection,
     not the current direction.

     This prevents a player from pressing
     two directions quickly and accidentally
     reversing into themselves.
    */

    if (
        queuedDirection.x === -x &&
        queuedDirection.y === -y
    ) {
        return;
    }


    /*
     Ignore the same direction.
    */

    if (
        queuedDirection.x === x &&
        queuedDirection.y === y
    ) {
        return;
    }


    queuedDirection = {
        x: x,
        y: y
    };
}


/* =========================================================
   KEYBOARD
   ========================================================= */

document.addEventListener(
    "keydown",
    event => {

        const key =
            event.key.toLowerCase();


        switch (key) {

            case "arrowup":
            case "w":

                event.preventDefault();

                changeDirection(
                    0,
                    -1
                );

                break;


            case "arrowdown":
            case "s":

                event.preventDefault();

                changeDirection(
                    0,
                    1
                );

                break;


            case "arrowleft":
            case "a":

                event.preventDefault();

                changeDirection(
                    -1,
                    0
                );

                break;


            case "arrowright":
            case "d":

                event.preventDefault();

                changeDirection(
                    1,
                    0
                );

                break;


            case " ":

                event.preventDefault();

                togglePause();

                break;


            case "enter":

                event.preventDefault();

                if (!running) {

                    startGame();

                }

                break;
        }
    }
);


/* =========================================================
   BUTTON HELPER
   ========================================================= */

function setupDirectionButton(
    elementId,
    x,
    y
) {

    const button =
        document.getElementById(
            elementId
        );


    button.addEventListener(
        "pointerdown",
        event => {

            event.preventDefault();

            changeDirection(
                x,
                y
            );
        }
    );
}


/* =========================================================
   D-PAD
   ========================================================= */

setupDirectionButton(
    "upButton",
    0,
    -1
);

setupDirectionButton(
    "downButton",
    0,
    1
);

setupDirectionButton(
    "leftButton",
    -1,
    0
);

setupDirectionButton(
    "rightButton",
    1,
    0
);


/* =========================================================
   ACTION BUTTONS
   ========================================================= */

document
    .getElementById("startButton")
    .addEventListener(
        "click",
        startGame
    );


document
    .getElementById("restartButton")
    .addEventListener(
        "click",
        startGame
    );


document
    .getElementById("pauseButton")
    .addEventListener(
        "click",
        togglePause
    );


/* =========================================================
   TOUCH / SWIPE
   ========================================================= */

let touchStartX = 0;

let touchStartY = 0;

let touchActive = false;


canvas.addEventListener(
    "pointerdown",
    event => {

        /*
         Ignore mouse pointers because
         mouse movement is not a swipe.
        */

        if (
            event.pointerType === "mouse"
        ) {
            return;
        }


        touchStartX =
            event.clientX;

        touchStartY =
            event.clientY;

        touchActive = true;
    }
);


canvas.addEventListener(
    "pointerup",
    event => {

        if (!touchActive) {
            return;
        }


        touchActive = false;


        const dx =
            event.clientX -
            touchStartX;

        const dy =
            event.clientY -
            touchStartY;


        const minimumSwipe =
            25;


        if (
            Math.abs(dx) <
                minimumSwipe &&
            Math.abs(dy) <
                minimumSwipe
        ) {
            return;
        }


        if (
            Math.abs(dx) >
            Math.abs(dy)
        ) {

            if (dx > 0) {

                changeDirection(
                    1,
                    0
                );

            } else {

                changeDirection(
                    -1,
                    0
                );
            }

        } else {

            if (dy > 0) {

                changeDirection(
                    0,
                    1
                );

            } else {

                changeDirection(
                    0,
                    -1
                );
            }
        }
    }
);


